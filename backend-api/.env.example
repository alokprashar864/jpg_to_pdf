# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jpg2pdf?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# API Port
API_PORT=4000

# Storage Config
S3_BUCKET_NAME="conversions"

# --- LOCAL DEVELOPMENT (MINIO) ---
S3_ENDPOINT="http://localhost:9000"
AWS_ACCESS_KEY_ID="admin"
AWS_SECRET_ACCESS_KEY="admin123"
AWS_REGION="us-east-1"

# --- PRODUCTION (CLOUDFLARE R2) ---
# To switch to Cloudflare R2 in production, comment out the MinIO variables above and uncomment below:
# S3_ENDPOINT="https://<YOUR_CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com"
# AWS_ACCESS_KEY_ID="<YOUR_R2_ACCESS_KEY>"
# AWS_SECRET_ACCESS_KEY="<YOUR_R2_SECRET_KEY>"
# AWS_REGION="auto"
